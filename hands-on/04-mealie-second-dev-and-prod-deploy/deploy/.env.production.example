# Copy to .env.production and fill in the real values. NEVER commit the real file.
ALLOW_SIGNUP=false
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Public entrypoint (nginx). Use https:// when TLS is configured.
BASE_URL=http://localhost:8080

# Database: values below are also read by docker-compose.prod.yml for interpolation,
# so start compose with `--env-file .env.production`.
DB_ENGINE=postgres
POSTGRES_USER=mealie
POSTGRES_PASSWORD=change-me
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mealie

API_PORT=9000
LOG_LEVEL=INFO

# OpenAI-compatible provider (DeepSeek works through the OpenAI SDK)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=deepseek-chat
OPENAI_REQUEST_TIMEOUT=120
